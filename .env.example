# ==============================================================================
# CONFIGURACIÓN DE ENVÍO DE EMAILS - CEIBO SOFTWARE
# ==============================================================================
# Para enviar los correos a ceibosoftware.ar@gmail.com con Gmail SMTP (Nodemailer),
# necesitas generar una "Contraseña de aplicación" en tu cuenta de Google.
#
# Pasos (toma 2 minutos):
# 1. Ingresa a https://myaccount.google.com/security con la cuenta ceibosoftware.ar@gmail.com
# 2. Asegúrate de tener activada la "Verificación en dos pasos".
# 3. Ve a "Contraseñas de aplicaciones" (o busca "App Passwords").
# 4. Crea una contraseña con el nombre "Ceibo Web" y copia los 16 caracteres generados.
# 5. Crea un archivo .env.local en la raíz de este proyecto y pega tus datos:

SMTP_USER=ceibosoftware.ar@gmail.com
SMTP_PASS=tu_contraseña_de_aplicacion_aqui
CONTACT_TO_EMAIL=ceibosoftware.ar@gmail.com
